};

const dashedBtnStyle = {
  width: "100%",
  border: `1.5px dashed ${TOKENS.line}`,
  background: "transparent",
  borderRadius: 8,
  padding: "9px",
  color: TOKENS.green,
  fontWeight: 600,
  fontSize: 13.5,
  cursor: "pointer",
  marginTop: 4,
};

const ghostIconBtn = {
  border: "none",
  background: "transparent",
  color: TOKENS.red,
  fontSize: 20,
  cursor: "pointer",
  lineHeight: 1,
};

const thStyle = { padding: "8px 6px", fontSize: 11.5, textTransform: "uppercase", letterSpacing: 0.4, color: "#5B6B57" };
const thStyleR = { ...thStyle, textAlign: "right" };
const tdStyle = { padding: "9px 6px" };
const tdStyleR = { ...tdStyle, textAlign: "right" };
