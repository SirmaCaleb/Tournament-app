  width: "100%",
  padding: "9px 12px",
  borderRadius: 7,
  border: `1.5px solid ${TOKENS.line}`,
  fontSize: 14,
  fontFamily: "'IBM Plex Sans', sans-serif",
  background: "#fff",
  color: TOKENS.ink,
  boxSizing: "border-box",
};

